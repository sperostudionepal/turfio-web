# Turfio web environment template
# VITE_* values are embedded into the browser bundle. NEVER put server secrets here.
VITE_API_URL=/api
VITE_USER_APP_URL=http://localhost:5173
VITE_PARTNER_APP_URL=http://partner.localhost:5173
VITE_SUPERADMIN_APP_URL=http://superadmin.localhost:5173

# Public browser client identifiers / restricted browser API keys only.
VITE_GOOGLE_CLIENT_ID=
VITE_MAPTILER_API_KEY=
# Optional development-only app-context override.
# VITE_APP_CONTEXT=user

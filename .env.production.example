# Turfio web environment template
# VITE_* values are embedded into the browser bundle. NEVER put server secrets here.
VITE_API_URL=/api
VITE_USER_APP_URL=https://turfio.com
VITE_PARTNER_APP_URL=https://partner.turfio.com
VITE_SUPERADMIN_APP_URL=https://superadmin.turfio.com

# Public browser client identifiers / restricted browser API keys only.
VITE_GOOGLE_CLIENT_ID=
VITE_MAPTILER_API_KEY=
